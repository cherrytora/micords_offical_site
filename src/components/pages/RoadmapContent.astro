---
import SectionHeader from '../SectionHeader.astro';

type Status = 'done' | 'building' | 'planned';

interface RoadmapItem {
  data: {
    quarter: string;
    title: string;
    desc: string;
    status: string;
    features: string[];
  };
}

interface Props {
  badge: string;
  title: string;
  subtitle: string;
  roadmap: RoadmapItem[];
  statusLabels: { done: string; building: string; planned: string };
  feedbackTitle: string;
  feedbackDesc: string;
  feedbackCta: string;
  contactHref: string;
}

const { badge, title, subtitle, roadmap, statusLabels, feedbackTitle, feedbackDesc, feedbackCta, contactHref } = Astro.props;

const statusConfig: Record<Status, { label: string; bg: string; text: string; dot: string }> = {
  done:     { label: statusLabels.done,     bg: 'bg-green-50',  text: 'text-green-700',    dot: 'bg-green-400' },
  building: { label: statusLabels.building, bg: 'bg-orange-50', text: 'text-brand-orange', dot: 'bg-brand-orange' },
  planned:  { label: statusLabels.planned,  bg: 'bg-slate-100', text: 'text-slate-500',    dot: 'bg-slate-300' },
};
---

<div class="pt-28 pb-20 px-6">
  <div class="max-w-4xl mx-auto">

    <SectionHeader badge={badge} title={title} subtitle={subtitle} />

    <div class="relative">
      <div class="absolute left-[2.25rem] top-0 bottom-0 w-0.5 bg-orange-100 hidden md:block"></div>

      <div class="space-y-10">
        {roadmap.map((item) => {
          const { quarter, title: itemTitle, desc, status, features } = item.data;
          const cfg = statusConfig[status as Status];
          return (
            <div class="md:flex gap-8 items-start">
              <div class="hidden md:flex flex-col items-center flex-shrink-0 w-[4.5rem]">
                <div class={`w-4 h-4 rounded-full mt-5 ${cfg.dot} ring-4 ring-white z-10`}></div>
              </div>

              <div class="flex-1 bg-white rounded-3xl border border-slate-100 shadow-sm p-8 hover:-translate-y-1 transition-transform duration-300">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                  <div>
                    <p class="text-sm font-bold text-slate-400 tracking-wide">{quarter}</p>
                    <h2 class="text-xl font-bold text-slate-900 mt-0.5">{itemTitle}</h2>
                  </div>
                  <span class={`px-3 py-1 rounded-full text-xs font-bold ${cfg.bg} ${cfg.text} flex items-center gap-1.5`}>
                    <span class={`w-1.5 h-1.5 rounded-full ${cfg.dot}`}></span>
                    {cfg.label}
                  </span>
                </div>
                <p class="text-slate-500 mb-5 leading-relaxed">{desc}</p>
                <ul class="space-y-2">
                  {features.map((f) => (
                    <li class="flex items-center gap-2 text-sm text-slate-600">
                      <span class="text-brand-orange">✦</span>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <div class="mt-16 bg-brand-cream rounded-3xl p-10 text-center">
      <h3 class="text-xl font-bold text-slate-900 mb-2">{feedbackTitle}</h3>
      <p class="text-slate-500 mb-6">{feedbackDesc}</p>
      <a
        href={contactHref}
        class="inline-block border-2 border-brand-orange text-brand-orange px-8 py-3 rounded-2xl font-bold hover:bg-orange-50 transition"
      >
        {feedbackCta}
      </a>
    </div>

  </div>
</div>
