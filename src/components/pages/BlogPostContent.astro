---
import CtaBlock from '../CtaBlock.astro';
import type { Locale } from '../../i18n/index';
import { formatDate } from '../../lib/utils';

interface Props {
  locale: Locale;
  title: string;
  publishDate: string;
  excerpt: string;
  tags?: string[];
  coverImage?: string;
  backHref: string;
  backLabel: string;
  ctaPre: string;
  ctaTitle: string;
  ctaDesc: string;
  ctaBtn: string;
  ctaUrl: string;
  showCoverInHeader?: boolean;
  Content: any;
}

const {
  locale, title, publishDate, excerpt, tags, coverImage,
  backHref, backLabel,
  ctaPre, ctaTitle, ctaDesc, ctaBtn, ctaUrl,
  showCoverInHeader = false,
  Content,
} = Astro.props;
---

<div class="pt-28 pb-20 px-6">
  <div class="max-w-2xl mx-auto">

    <a
      href={backHref}
      class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-brand-orange transition mb-10"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      {backLabel}
    </a>

    <header class="mb-10">
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-5">
          {tags.map((tag) => (
            <span class="px-3 py-1 bg-orange-50 text-brand-orange text-xs font-medium rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}
      <h1 class="text-3xl font-bold text-slate-900 leading-snug mb-4">{title}</h1>
      {showCoverInHeader && coverImage && (
        <img src={coverImage} alt={title} class="w-full rounded-3xl shadow-lg mb-6 object-cover max-h-80" loading="eager" />
      )}
      <time class="text-sm text-slate-400 font-medium" datetime={publishDate}>
        {formatDate(publishDate, locale)}
      </time>
    </header>

    <article class="prose prose-slate max-w-none
      prose-headings:font-bold prose-headings:text-slate-900
      prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-lg prose-h3:mt-6 prose-h3:mb-3
      prose-p:text-slate-600 prose-p:leading-relaxed prose-p:mb-4
      prose-li:text-slate-600 prose-li:leading-relaxed prose-li:my-3
      prose-strong:text-slate-800
      prose-a:text-brand-orange prose-a:no-underline hover:prose-a:underline
      prose-hr:border-slate-100 prose-hr:my-10
      prose-blockquote:border-l-4 prose-blockquote:border-slate-200 prose-blockquote:bg-slate-50 prose-blockquote:text-slate-600 prose-blockquote:px-6 prose-blockquote:py-4
      prose-img:rounded-3xl prose-img:shadow-lg prose-img:mt-6 prose-img:mb-6
      prose-ul:list-disc prose-ol:list-decimal prose-ul:pl-6 prose-ol:pl-6
      prose-code:bg-slate-100 prose-code:px-2 prose-code:py-1 prose-code:rounded-md
    ">
      <Content />
    </article>

    <CtaBlock pre={ctaPre} title={ctaTitle} subtitle={ctaDesc} btnText={ctaBtn} btnHref={ctaUrl} />

  </div>
</div>
