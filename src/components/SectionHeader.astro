---
interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  level?: 'h1' | 'h2';
}
const { badge, title, subtitle, level = 'h1' } = Astro.props;
const Tag = level;
---
<div class="text-center mb-16">
  {badge && <p class="text-brand-orange font-bold tracking-widest uppercase text-sm mb-3">{badge}</p>}
  <Tag class="text-4xl font-bold text-slate-900 mb-4">{title}</Tag>
  {subtitle && <p class="text-slate-500 text-lg">{subtitle}</p>}
</div>
