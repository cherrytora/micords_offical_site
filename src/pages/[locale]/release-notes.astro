---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import type { Locale } from '../../i18n/index';
import { useTranslations } from '../../i18n/index';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'ja' } },
  ];
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const r = t.releaseNotes;

const notes = (await getCollection('release-notes')).filter(n => n.id.startsWith(`${locale}/`)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function formatDate(dateStr: string) {
  const localeMap: Record<Locale, string> = { 'zh-tw': 'zh-TW', 'en': 'en-US', 'ja': 'ja-JP' };
  return new Date(dateStr).toLocaleDateString(localeMap[locale] ?? 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title={r.seoTitle} description={r.seoDescription}>
  <Nav />

  <div class="pt-28 pb-20 px-6">
    <div class="max-w-3xl mx-auto">

      <div class="text-center mb-16">
        <p class="text-brand-orange font-bold tracking-widest uppercase text-sm mb-3">{r.badge}</p>
        <h1 class="text-4xl font-bold text-slate-900 mb-4">{r.title}</h1>
        <p class="text-slate-500 text-lg">{r.subtitle}</p>
      </div>

      <div class="space-y-10">
        {await Promise.all(notes.map(async (note, index) => {
          const { Content } = await note.render();
          return (
            <article class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
              <div class="px-8 py-6 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
                <div>
                  <span class={`inline-block px-3 py-1 rounded-full text-xs font-bold mb-2 ${
                    index === 0 ? 'bg-orange-100 text-brand-orange' : 'bg-slate-100 text-slate-500'
                  }`}>
                    {index === 0 ? r.latest : r.old}
                  </span>
                  <h2 class="text-xl font-bold text-slate-900">
                    v{note.data.version} — {note.data.title}
                  </h2>
                </div>
                <time datetime={note.data.date} class="text-sm text-slate-400 font-medium">
                  {formatDate(note.data.date)}
                </time>
              </div>
              <div class="px-8 py-6 text-sm text-slate-600 leading-relaxed
                [&_h2]:text-base [&_h2]:font-bold [&_h2]:text-slate-800 [&_h2]:mt-4 [&_h2]:mb-2
                [&_h3]:text-sm [&_h3]:font-bold [&_h3]:text-slate-700 [&_h3]:mt-3 [&_h3]:mb-1.5
                [&_ul]:space-y-1 [&_ul]:my-2
                [&_li]:flex [&_li]:gap-2 [&_li]:before:content-['–'] [&_li]:before:text-brand-orange [&_li]:before:flex-shrink-0
                [&_strong]:font-semibold [&_strong]:text-slate-700
                [&_p]:mb-2">
                <Content />
              </div>
            </article>
          );
        }))}
      </div>

    </div>
  </div>

  <Footer />
</BaseLayout>
