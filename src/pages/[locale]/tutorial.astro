---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import TutorialContent from '../../components/pages/TutorialContent.astro';
import { getEntry } from 'astro:content';
import type { Locale } from '../../i18n/index';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'ja' } },
  ];
}

const { locale } = Astro.params as { locale: Locale };

const tutorial = await getEntry('tutorial', `${locale}/page`);
const { pageTitle, pageSubtitle, sections, ctaTitle, ctaSubtitle, ctaButton, seoTitle, seoDescription } = tutorial.data;
const { data: { ctaUrl } } = await getEntry('global', 'settings');
---

<BaseLayout title={seoTitle ?? pageTitle} description={seoDescription}>
  <Nav />
  <TutorialContent
    pageTitle={pageTitle}
    pageSubtitle={pageSubtitle}
    sections={sections}
    ctaTitle={ctaTitle}
    ctaSubtitle={ctaSubtitle}
    ctaButton={ctaButton}
    ctaUrl={ctaUrl}
  />
  <Footer />
</BaseLayout>
