---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import BlogPostContent from '../../../components/pages/BlogPostContent.astro';
import type { Locale } from '../../../i18n/index';
import { localePath, useTranslations } from '../../../i18n/index';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const locales = ['en', 'ja'] as const;
  return locales.flatMap((locale) =>
    articles
      .filter((a) => a.id.startsWith(`${locale}/`))
      .map((article) => ({
        params: { locale, slug: article.slug.replace(`${locale}/`, '') },
        props: { article },
      }))
  );
}

const { locale } = Astro.params as { locale: Locale };
const { article } = Astro.props;
const { Content } = await article.render();
const { title, publishDate, excerpt, tags, coverImage } = article.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://micordshq.web.app';
const { data: { ctaUrl } } = await getEntry('global', 'settings');
const t = useTranslations(locale);
const labels = t.blogPost;
const pureSlug = article.slug.replace(`${locale}/`, '');
const articleUrl = `${siteUrl}/${locale}/blog/${pureSlug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: publishDate,
  url: articleUrl,
  image: coverImage ? `${siteUrl}${coverImage}` : `${siteUrl}/Micords.png`,
  author: { '@type': 'Organization', name: 'Micords', url: siteUrl },
  publisher: {
    '@type': 'Organization',
    name: 'Micords',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/Micords-icon.png` },
  },
};
---

<BaseLayout title={`${title} | Micords`} description={excerpt}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <Nav />
  <BlogPostContent
    locale={locale}
    title={title}
    publishDate={publishDate}
    excerpt={excerpt}
    tags={tags}
    coverImage={coverImage}
    backHref={localePath(locale, '/blog', base)}
    backLabel={labels.back}
    ctaPre={labels.cta_pre}
    ctaTitle={labels.cta_title}
    ctaDesc={labels.cta_desc}
    ctaBtn={labels.cta_btn}
    ctaUrl={ctaUrl}
    showCoverInHeader={true}
    Content={Content}
  />
  <Footer />
</BaseLayout>
