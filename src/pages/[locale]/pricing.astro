---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PricingContent from '../../components/pages/PricingContent.astro';
import type { Locale } from '../../i18n/index';
import { getEntry } from 'astro:content';

export function getStaticPaths() { return [{ params: { locale: 'en' } }, { params: { locale: 'ja' } }]; }
const { locale } = Astro.params as { locale: Locale };
const p = await getEntry('pricing', `${locale}/page`);
const { seoTitle, seoDescription, pageTitle, pageSubtitle, trialBadge, periodMonthly, periodAnnual, periodAnnualSave, plans, notes, ctaTitle, ctaSubtitle, ctaButton } = p.data;
const { data: { ctaUrl } } = await getEntry('global', 'settings');
const en = locale === 'en';
const copy = en ? {
  comparison: 'Full Feature Comparison', feature: 'Feature', limits: 'Basic Limits', cats: 'Number of cats', addCat: 'Additional cats from the 6th', addCatValue: '+NT$10/month or +NT$100/year per cat', addCatNote: '+2/month for each AI summary type', dailyCare: 'Daily Care', dailyRecords: 'Quick Records, daily records & Today’s Care', singleReminders: 'Single reminders (vaccines / follow-ups)', chart: 'Charts & Export', basicCharts: 'Weight, food & water charts', history: 'Chart history', fullExport: 'Full trend charts & PDF export', care: 'Medical & Care', medicalRecords: 'Vet visit records & blood test values', scan: 'Blood test scan', photos: 'Photo uploads', freePhotos: '1 per record / 50 total', premiumPhotos: '5 per record / unlimited total', tools: 'Repeat reminders, medication management, Health Score & Risk Alerts', expenses: 'Supplies & Expenses', expenseTools: 'Supply stash, expense tracking & medical fund', ai: 'AI Features', daily: 'AI daily health summary', visit: 'AI visit report summary', months: '6 months', unlimited: 'Unlimited', times: 'times/month', catsFree: '2 cats', catsPremium: '5 cats', perMonth: '/mo',
} : {
  comparison: '機能比較', feature: '機能', limits: '基本制限', cats: '猫の数', addCat: '6匹目からの追加', addCatValue: '1匹につき月額NT$10／年額NT$100追加', addCatNote: '2種類のAIサマリーが各月2回追加', dailyCare: '日常ケア', dailyRecords: 'クイック記録・日常記録・今日のケア', singleReminders: '単発リマインダー（ワクチン／再診）', chart: 'グラフとエクスポート', basicCharts: '体重・食事・飲水グラフ', history: 'グラフ履歴', fullExport: '完全なトレンドグラフとPDFエクスポート', care: '医療とケア', medicalRecords: '診察記録と血液検査値', scan: '血液検査スキャン', photos: '写真アップロード', freePhotos: '1記録につき1枚／合計50枚', premiumPhotos: '1記録につき5枚／合計無制限', tools: '繰り返しリマインダー・薬管理・健康スコア・リスク通知', expenses: '用品と支出', expenseTools: 'ストック管理・家計簿・医療基金', ai: 'AI機能', daily: 'AI日常健康サマリー', visit: 'AI診察レポートサマリー', months: '6か月', unlimited: '無制限', times: '回/月', catsFree: '2匹', catsPremium: '5匹', perMonth: '/月',
};
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <Nav />
  <div class="pt-28 pb-20 px-6"><div class="max-w-5xl mx-auto">
    <PricingContent {...{ pageTitle, pageSubtitle, trialBadge, periodMonthly, periodAnnual, periodAnnualSave, plans, notes, ctaTitle, ctaSubtitle, ctaButton, ctaUrl }} perMonthLabel={copy.perMonth}>
      <div class="mb-16"><h2 class="text-2xl font-bold text-slate-900 text-center mb-8">{copy.comparison}</h2>
        <div class="overflow-x-auto rounded-3xl border border-slate-100 shadow-sm"><table class="w-full text-sm"><thead><tr class="bg-slate-50 border-b border-slate-100"><th class="text-left px-6 py-4 font-semibold text-slate-500 w-1/2">{copy.feature}</th><th class="text-center px-4 py-4 font-semibold text-slate-600">Free</th><th class="text-center px-4 py-4 font-semibold text-brand-orange">Premium</th></tr></thead>
        <tbody class="divide-y divide-slate-50">
          <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">{copy.limits}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.cats}</td><td class="text-center px-4 py-3.5">{copy.catsFree}</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">{copy.catsPremium}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.addCat}</td><td class="text-center px-4 py-3.5 text-slate-300">—</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">{copy.addCatValue}<br /><span class="text-xs font-normal text-slate-500">{copy.addCatNote}</span></td></tr>
          <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">{copy.dailyCare}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.dailyRecords}</td><td class="text-center px-4 py-3.5">✓</td><td class="text-center px-4 py-3.5">✓</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.singleReminders}</td><td class="text-center px-4 py-3.5">✓</td><td class="text-center px-4 py-3.5">✓</td></tr>
          <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">{copy.chart}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.basicCharts}</td><td class="text-center px-4 py-3.5">✓</td><td class="text-center px-4 py-3.5">✓</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.history}</td><td class="text-center px-4 py-3.5 text-slate-500">{copy.months}</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">{copy.unlimited}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.fullExport}</td><td class="text-center px-4 py-3.5 text-slate-300">—</td><td class="text-center px-4 py-3.5">✓</td></tr>
          <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">{copy.care}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.medicalRecords}</td><td class="text-center px-4 py-3.5">✓</td><td class="text-center px-4 py-3.5">✓</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.scan}</td><td class="text-center px-4 py-3.5 text-slate-500">2 {copy.times}</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">{copy.unlimited}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.photos}</td><td class="text-center px-4 py-3.5 text-slate-500">{copy.freePhotos}</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">{copy.premiumPhotos}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.tools}</td><td class="text-center px-4 py-3.5 text-slate-300">—</td><td class="text-center px-4 py-3.5">✓</td></tr>
          <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">{copy.expenses}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.expenseTools}</td><td class="text-center px-4 py-3.5">✓</td><td class="text-center px-4 py-3.5">✓</td></tr>
          <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">{copy.ai}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.daily}</td><td class="text-center px-4 py-3.5 text-slate-300">—</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">10 {copy.times}</td></tr>
          <tr><td class="px-6 py-3.5 text-slate-700">{copy.visit}</td><td class="text-center px-4 py-3.5 text-slate-300">—</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">10 {copy.times}</td></tr>
        </tbody></table></div>
      </div>
    </PricingContent>
  </div></div>
  <Footer />
</BaseLayout>

<script>
  function setPeriod(period) {
    document.querySelectorAll('[data-monthly-price]').forEach((el) => { el.textContent = period === 'monthly' ? el.dataset.monthlyPrice : el.dataset.annualPrice; });
    document.querySelectorAll('[data-plan-subtitle]').forEach((el) => { el.textContent = period === 'monthly' ? el.dataset.monthlySubtitle : el.dataset.annualSubtitle; });
    const btnMonthly = document.getElementById('btn-monthly'); const btnAnnual = document.getElementById('btn-annual');
    if (!btnMonthly || !btnAnnual) return;
    btnMonthly.className = `px-5 py-2 rounded-xl text-sm font-semibold transition ${period === 'monthly' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500'}`;
    btnAnnual.className = `px-5 py-2 rounded-xl text-sm font-semibold transition ${period === 'annual' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500'}`;
  }
  window.setPeriod = setPeriod;
</script>
