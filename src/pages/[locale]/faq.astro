---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import type { Locale } from '../../i18n/index';
import { useTranslations, localePath } from '../../i18n/index';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'ja' } },
  ];
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faqData = await getEntry('faq', `${locale}/page`);
const { faqs } = faqData.data;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<BaseLayout title={t.contact.seoTitle.replace('Contact Us', 'FAQ').replace('お問い合わせ', 'よくある質問')} description={t.contact.seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Nav />

  <div class="pt-28 pb-20 px-6">
    <div class="max-w-3xl mx-auto">

      <div class="text-center mb-16">
        <p class="text-brand-orange font-bold tracking-widest uppercase text-sm mb-3">FAQ</p>
        <h1 class="text-4xl font-bold text-slate-900 mb-4">FAQ</h1>
        <p class="text-slate-500 text-lg">
          {locale === 'en' ? "Can't find an answer? Feel free to contact us." : '答えが見つかりませんか？お気軽にお問い合わせください。'}
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map(({ question, answer }) => (
          <details class="group bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <summary class="flex items-center justify-between gap-4 px-8 py-6 cursor-pointer list-none">
              <h2 class="font-bold text-slate-900 text-base leading-snug">{question}</h2>
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-orange-50 flex items-center justify-center text-brand-orange transition-transform group-open:rotate-45">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <div class="px-8 pb-6 text-slate-500 text-sm leading-relaxed border-t border-slate-50 pt-4">
              {answer}
            </div>
          </details>
        ))}
      </div>

      <div class="mt-16 bg-brand-cream rounded-3xl p-10 text-center">
        <h2 class="text-xl font-bold text-slate-900 mb-2">
          {locale === 'en' ? 'Still have questions?' : 'まだご質問はありますか？'}
        </h2>
        <p class="text-slate-500 mb-6">
          {locale === 'en' ? 'Reach us via Threads or the feedback form.' : 'ThreadsまたはフィードバックフォームでMicordsチームにご連絡ください。'}
        </p>
        <a
          href={localePath(locale, '/contact', base)}
          class="inline-block border-2 border-brand-orange text-brand-orange px-8 py-3 rounded-2xl font-bold hover:bg-orange-50 transition"
        >
          {t.nav.contact}
        </a>
      </div>

    </div>
  </div>

  <Footer />
</BaseLayout>
