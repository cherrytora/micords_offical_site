---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FaqContent from '../../components/pages/FaqContent.astro';
import type { Locale } from '../../i18n/index';
import { useTranslations, localePath } from '../../i18n/index';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'ja' } },
  ];
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faqData = await getEntry('faq', `${locale}/page`);
const { faqs } = faqData.data;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

const faqLabels = {
  en: { title: 'FAQ', subtitle: "Can't find an answer? Feel free to contact us.", contactTitle: 'Still have questions?', contactDesc: 'Reach us via Threads or the feedback form.' },
  ja: { title: 'FAQ', subtitle: '答えが見つかりませんか？お気軽にお問い合わせください。', contactTitle: 'まだご質問はありますか？', contactDesc: 'ThreadsまたはフィードバックフォームでMicordsチームにご連絡ください。' },
};
const fl = faqLabels[locale as 'en' | 'ja'];
---

<BaseLayout title={t.contact.seoTitle.replace('Contact Us', 'FAQ').replace('お問い合わせ', 'よくある質問')} description={t.contact.seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Nav />
  <FaqContent
    badge="FAQ"
    title={fl.title}
    subtitle={fl.subtitle}
    faqs={faqs}
    contactHref={localePath(locale, '/contact', base)}
    contactTitle={fl.contactTitle}
    contactDesc={fl.contactDesc}
    contactCta={t.nav.contact}
  />
  <Footer />
</BaseLayout>
