---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import type { Locale } from '../../i18n/index';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'ja' } },
  ];
}

const { locale } = Astro.params as { locale: Locale };

const content = {
  en: {
    seoTitle: 'Privacy Policy | Micords Cat Health Records',
    seoDesc: 'Privacy Policy for Micords Cat Health Records — how we collect, use, and protect your personal data.',
    title: 'Privacy Policy',
    updated: 'Last Updated: March 18, 2026',
    intro1: 'Welcome to Micords Cat Health Records (hereinafter referred to as "the Service").',
    intro2: 'We are committed to protecting the privacy and personal data of our users. This Privacy Policy sets forth the manner in which we collect, use, store, and protect your information in connection with your use of the Service.',
    sections: [
      {
        heading: 'Article 1 — Personal Data We Collect',
        body: `
          <p>When you use the Service, we may collect the following categories of information:</p>
          <p><strong>1. Information You Provide Directly</strong></p>
          <ul>
            <li>Email address (for account registration and authentication)</li>
            <li>Cat-related information (name, health records, blood test values, etc.)</li>
            <li>Daily records you enter (dietary intake, elimination, medication, etc.)</li>
          </ul>
          <p><strong>2. Data Automatically Generated by the System</strong></p>
          <ul>
            <li>Usage timestamps and operation logs (used to improve the Service)</li>
          </ul>
        `,
      },
      {
        heading: 'Article 2 — Purposes of Data Processing',
        body: `
          <p>We collect and process your personal data solely for the following purposes:</p>
          <ul>
            <li>To provide and operate the features of the Service (e.g., records, charts, and push notifications)</li>
            <li>To improve product experience and feature design</li>
            <li>To analyze usage patterns in order to optimize the Service</li>
            <li>To contact you when necessary (e.g., important service notices, beta testing feedback)</li>
          </ul>
          <p>We do not sell, rent, or otherwise disclose your personal data to third parties for advertising or marketing purposes.</p>
        `,
      },
      {
        heading: 'Article 3 — Data Storage and Security',
        body: `
          <ul>
            <li>Your data is stored in a secure system environment.</li>
            <li>We implement reasonable technical and organizational measures to prevent unauthorized access, disclosure, alteration, or destruction of your personal data.</li>
            <li>Please be advised that no method of data transmission over the Internet or electronic storage can guarantee absolute security. You are encouraged to assess the associated risks at your own discretion.</li>
          </ul>
        `,
      },
      {
        heading: 'Article 4 — Data Sharing and Third-Party Disclosure',
        body: `
          <p>We do not, as a general rule, share your personal data with third parties, except in the following circumstances:</p>
          <ul>
            <li>With your prior consent</li>
            <li>Where necessary to provide the Service (e.g., cloud infrastructure and hosting providers)</li>
            <li>Where required by applicable law or pursuant to a lawful request by a competent governmental or regulatory authority</li>
          </ul>
        `,
      },
      {
        heading: 'Article 5 — Data Deletion and User Rights',
        body: `
          <p>You may, at any time, exercise the following rights:</p>
          <ul>
            <li>Request the deletion of your account and all associated personal data</li>
            <li>Discontinue use of the Service</li>
          </ul>
          <p>To submit a data deletion request, please contact us via email.</p>
        `,
      },
      {
        heading: 'Article 6 — Cookies and Tracking Technologies',
        body: `
          <p>The Service uses cookies and similar tracking technologies for the following purposes:</p>
          <ul>
            <li>To maintain your authenticated session</li>
            <li>To enhance user experience</li>
            <li>To analyze usage behavior (e.g., which features are accessed and utilized)</li>
          </ul>
          <p>You may disable cookies through your browser settings; however, doing so may impair the functionality of certain features of the Service.</p>
        `,
      },
      {
        heading: 'Article 7 — Beta Phase Notice',
        body: `
          <p>The Service is currently operating in a beta testing phase. Please be aware of the following:</p>
          <ul>
            <li>Features and functionalities may be modified, suspended, or discontinued at any time without prior notice.</li>
            <li>Data may be adjusted or deleted as a result of system testing or maintenance.</li>
            <li>We strongly advise against storing uniquely irreplaceable data exclusively within the Service during this phase.</li>
          </ul>
        `,
      },
      {
        heading: 'Article 8 — Amendments to This Policy',
        body: `<p>We reserve the right to amend this Privacy Policy from time to time. Any material revisions shall be published within the Service upon taking effect.</p>`,
      },
      {
        heading: 'Article 9 — Protection of Minors',
        body: `<p>The Service is intended primarily for adult pet owners. If you are under the age of eighteen (18), please use the Service only with the consent of a parent or legal guardian. If we become aware that personal data has been inadvertently collected from a minor, we will take prompt measures to delete such data upon receipt of notification.</p>`,
      },
      {
        heading: 'Article 10 — Contact Information',
        body: `
          <p>For any inquiries or requests relating to your personal data, please contact us at:</p>
          <ul>
            <li>Email: <a href="mailto:m85592527@gmail.com">m85592527@gmail.com</a></li>
          </ul>
        `,
      },
      {
        heading: 'Article 11 — Governing Law and Jurisdiction',
        body: `<p>This Privacy Policy shall be governed by and construed in accordance with the laws of the Republic of China (Taiwan). Any dispute arising out of or in connection with this Privacy Policy shall be subject to the exclusive jurisdiction of the Taipei District Court of Taiwan as the court of first instance.</p>`,
      },
    ],
    consent: 'By using the Service, you acknowledge that you have read and agree to this Privacy Policy.',
  },

  ja: {
    seoTitle: 'プライバシーポリシー | Micords 猫の健康記録簿',
    seoDesc: 'Micords 猫の健康記録簿のプライバシーポリシー — 個人情報の収集・利用・保護に関する取り扱いについて。',
    title: 'プライバシーポリシー',
    updated: '最終更新日：2026年3月18日',
    intro1: 'Micords 猫の健康記録簿（以下「本サービス」といいます）をご利用いただきありがとうございます。',
    intro2: '当社は、ユーザーの個人情報およびプライバシーの保護を重視しています。本プライバシーポリシーは、本サービスのご利用に際して収集・利用・保管・保護する情報の取り扱いについて定めるものです。',
    sections: [
      {
        heading: '第1条（収集する個人情報）',
        body: `
          <p>本サービスのご利用に際し、当社は以下の情報を収集する場合があります。</p>
          <p><strong>1. ユーザーが直接提供する情報</strong></p>
          <ul>
            <li>メールアドレス（アカウント登録および認証のため）</li>
            <li>猫に関する情報（名前、健康記録、血液検査値等）</li>
            <li>ユーザーが入力する日常記録（食事・排泄・投薬等）</li>
          </ul>
          <p><strong>2. システムが自動的に生成する情報</strong></p>
          <ul>
            <li>利用日時および操作ログ（サービス改善を目的として使用）</li>
          </ul>
        `,
      },
      {
        heading: '第2条（個人情報の利用目的）',
        body: `
          <p>収集した個人情報は、以下の目的のみに利用します。</p>
          <ul>
            <li>本サービスの機能提供（記録・グラフ・プッシュ通知等）</li>
            <li>製品体験および機能設計の改善</li>
            <li>利用状況の分析によるサービス最適化</li>
            <li>必要に応じたユーザーへの連絡（重要なお知らせ・ベータ版フィードバック等）</li>
          </ul>
          <p>収集した個人情報を広告または宣伝目的で第三者に販売、貸与、または開示することはありません。</p>
        `,
      },
      {
        heading: '第3条（データの保管およびセキュリティ）',
        body: `
          <ul>
            <li>ユーザーのデータは安全なシステム環境に保管されます。</li>
            <li>個人情報への不正アクセス・漏洩・改ざん・破壊を防止するための合理的な技術的・組織的措置を講じます。</li>
            <li>インターネットを介したデータ送信および電子的な保管方法は、完全な安全性を保証するものではありません。リスクについてはユーザー自身の判断でご評価ください。</li>
          </ul>
        `,
      },
      {
        heading: '第4条（情報の共有および第三者への提供）',
        body: `
          <p>原則として、ユーザーの個人情報を第三者に提供することはありません。ただし、以下の場合はこの限りではありません。</p>
          <ul>
            <li>ユーザーの事前の同意がある場合</li>
            <li>本サービスの提供に必要な場合（例：クラウドインフラストラクチャおよびホスティング提供者）</li>
            <li>適用される法令に基づく場合、または権限ある行政機関もしくは監督機関による適法な要求がある場合</li>
          </ul>
        `,
      },
      {
        heading: '第5条（データの削除およびユーザーの権利）',
        body: `
          <p>ユーザーはいつでも以下の権利を行使することができます。</p>
          <ul>
            <li>アカウントおよびすべての関連個人情報の削除を要求する権利</li>
            <li>本サービスの利用を停止する権利</li>
          </ul>
          <p>データの削除をご希望の場合は、メールにてお問い合わせください。</p>
        `,
      },
      {
        heading: '第6条（クッキーおよびトラッキング技術）',
        body: `
          <p>本サービスは、以下の目的でクッキーおよび類似のトラッキング技術を使用します。</p>
          <ul>
            <li>認証済みセッションの維持</li>
            <li>ユーザー体験の向上</li>
            <li>利用行動の分析（例：アクセスおよび利用された機能の把握）</li>
          </ul>
          <p>ブラウザの設定によりクッキーを無効にすることができますが、本サービスの一部の機能に支障が生じる場合があります。</p>
        `,
      },
      {
        heading: '第7条（ベータ版期間中の注意事項）',
        body: `
          <p>本サービスは現在ベータテスト段階にあります。以下の点にご注意ください。</p>
          <ul>
            <li>機能および仕様は、予告なく変更、一時停止、または廃止される場合があります。</li>
            <li>システムテストまたはメンテナンスの結果、データが調整または削除される場合があります。</li>
            <li>本サービスのベータ版期間中は、重要なデータを本サービスのみに保存することを強くお控えいただくことを推奨します。</li>
          </ul>
        `,
      },
      {
        heading: '第8条（本ポリシーの変更）',
        body: `<p>当社は、本プライバシーポリシーを随時改訂する権利を留保します。重要な変更が生じた場合は、改訂後の内容を本サービス内にて公表します。</p>`,
      },
      {
        heading: '第9条（未成年者の保護）',
        body: `<p>本サービスは主として成年のペット飼育者を対象としています。18歳未満の方が本サービスをご利用になる場合は、保護者または法定後見人の同意のもとでご利用ください。未成年者の個人情報を意図せず収集したことが判明した場合、通知を受け次第、速やかに当該情報を削除します。</p>`,
      },
      {
        heading: '第10条（お問い合わせ）',
        body: `
          <p>個人情報に関するご質問またはご要望は、以下の連絡先までお問い合わせください。</p>
          <ul>
            <li>メール：<a href="mailto:m85592527@gmail.com">m85592527@gmail.com</a></li>
          </ul>
        `,
      },
      {
        heading: '第11条（準拠法および管轄裁判所）',
        body: `<p>本プライバシーポリシーは、中華民国（台湾）法に準拠し、解釈されるものとします。本ポリシーに起因または関連する紛争については、台湾台北地方裁判所を第一審の専属的合意管轄裁判所とします。</p>`,
      },
    ],
    consent: '本サービスをご利用いただくことにより、本プライバシーポリシーをお読みいただき、その内容に同意したものとみなします。',
  },
};

const t = content[locale];
---

<BaseLayout title={t.seoTitle} description={t.seoDesc}>
  <Nav />

  <div class="pt-28 pb-20 px-6">
    <div class="max-w-2xl mx-auto">

      <header class="mb-12">
        <h1 class="text-3xl font-bold text-slate-900 mb-2">{t.title}</h1>
        <p class="text-sm text-slate-400">{t.updated}</p>
      </header>

      <div class="prose prose-slate max-w-none
        prose-headings:font-bold prose-headings:text-slate-900
        prose-h2:text-lg prose-h2:mt-10 prose-h2:mb-3
        prose-p:text-slate-600 prose-p:leading-relaxed prose-p:mb-4
        prose-li:text-slate-600 prose-li:leading-relaxed prose-li:my-1
        prose-strong:text-slate-800
        prose-a:text-brand-orange prose-a:no-underline hover:prose-a:underline
        prose-hr:border-slate-100 prose-hr:my-8
        prose-ul:list-disc prose-ul:pl-6 prose-ol:list-decimal prose-ol:pl-6
      ">

        <p>{t.intro1}</p>
        <p>{t.intro2}</p>

        <hr />

        {t.sections.map(({ heading, body }) => (
          <>
            <h2>{heading}</h2>
            <Fragment set:html={body} />
          </>
        ))}

        <hr />

        <p class="text-sm font-bold !text-brand-orange">{t.consent}</p>

      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>
