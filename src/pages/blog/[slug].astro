---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BlogPostContent from '../../components/pages/BlogPostContent.astro';
import { useTranslations } from '../../i18n/index';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  // Only zh-tw articles (no locale prefix in URL)
  return articles
    .filter((a) => a.id.startsWith('zh-tw/'))
    .map((article) => ({
      params: { slug: article.slug.replace('zh-tw/', '') },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const { title, publishDate, excerpt, tags, coverImage } = article.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://micords.com';
const { data: { ctaUrl } } = await getEntry('global', 'settings');
const t = useTranslations('zh-tw');
const labels = t.blogPost;
const pureSlug = article.slug.replace('zh-tw/', '');
const articleUrl = `${siteUrl}/blog/${pureSlug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: publishDate,
  url: articleUrl,
  image: coverImage ? `${siteUrl}${coverImage}` : `${siteUrl}/Micords.png`,
  author: { '@type': 'Organization', name: 'Micords', url: siteUrl },
  publisher: {
    '@type': 'Organization',
    name: 'Micords',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/Micords-icon.png` },
  },
};
---

<BaseLayout title={`${title}｜Micords 毛孩日記`} description={excerpt}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <Nav />
  <BlogPostContent
    locale="zh-tw"
    title={title}
    publishDate={publishDate}
    excerpt={excerpt}
    tags={tags}
    coverImage={coverImage}
    backHref={`${base}/blog`}
    backLabel={labels.back}
    ctaPre={labels.cta_pre}
    ctaTitle={labels.cta_title}
    ctaDesc={labels.cta_desc}
    ctaBtn={labels.cta_btn}
    ctaUrl={ctaUrl}
    Content={Content}
  />
  <Footer />
</BaseLayout>
