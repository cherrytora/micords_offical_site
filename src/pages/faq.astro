---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FaqContent from '../components/pages/FaqContent.astro';

const faqData = await getEntry('faq', 'zh-tw/page');
const { faqs } = faqData.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<BaseLayout
  title="Micords FAQ｜貓咪健康紀錄 APP 常見問題"
  description="Micords 常見問題解答，包含 APP 功能介紹、血檢紀錄使用方式、記帳簿、物品倉庫、PWA 安裝教學等，幫你快速上手毛孩健康管理。"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Nav />
  <FaqContent
    badge="FAQ"
    title="FAQ"
    subtitle="找不到答案？歡迎直接聯絡我們。"
    faqs={faqs}
    contactHref={`${base}/contact`}
    contactTitle="還有其他問題？"
    contactDesc="歡迎透過 Threads 或意見表單直接找我們。"
    contactCta="聯絡我們"
  />
  <Footer />
</BaseLayout>
