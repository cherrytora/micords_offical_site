---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PricingContent from '../components/pages/PricingContent.astro';
import { getEntry } from 'astro:content';

const p = await getEntry('pricing', 'zh-tw/page');
const { seoTitle, seoDescription, pageTitle, pageSubtitle, trialBadge, periodMonthly, periodAnnual, periodAnnualSave, plans, notes, ctaTitle, ctaSubtitle, ctaButton } = p.data;
const { data: { ctaUrl } } = await getEntry('global', 'settings');
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <Nav />
  <div class="pt-28 pb-20 px-6"><div class="max-w-5xl mx-auto">
    <PricingContent {...{ pageTitle, pageSubtitle, trialBadge, periodMonthly, periodAnnual, periodAnnualSave, plans, notes, ctaTitle, ctaSubtitle, ctaButton, ctaUrl }} perMonthLabel="/月">
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-slate-900 text-center mb-8">完整功能比較</h2>
        <div class="overflow-x-auto rounded-3xl border border-slate-100 shadow-sm">
          <table class="w-full text-sm"><thead><tr class="bg-slate-50 border-b border-slate-100"><th class="text-left px-6 py-4 font-semibold text-slate-500 w-1/2">功能</th><th class="text-center px-4 py-4 font-semibold text-slate-600">Free</th><th class="text-center px-4 py-4 font-semibold text-brand-orange">Premium</th></tr></thead>
          <tbody class="divide-y divide-slate-50">
            <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">基本限制</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">貓咪數量</td><td class="text-center px-4 py-3.5">2 隻</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">5 隻</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">第 6 隻起加購</td><td class="text-center px-4 py-3.5 text-slate-300">—</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">每隻 +NT$10/月；年繳 +NT$100/年<br /><span class="text-xs font-normal text-slate-500">AI 日常摘要、AI 看診摘要各 +2 次/月</span></td></tr>
            <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">日常照護</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">快速紀錄、日常紀錄與今日照護</td><td class="text-center px-4 py-3.5">✓</td><td class="text-center px-4 py-3.5">✓</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">單次提醒（疫苗／回診）</td><td class="text-center px-4 py-3.5">✓</td><td class="text-center px-4 py-3.5">✓</td></tr>
            <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">健康圖表與匯出</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">體重、飲食與飲水圖表</td><td class="text-center px-4 py-3.5">✓</td><td class="text-center px-4 py-3.5">✓</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">圖表顯示範圍</td><td class="text-center px-4 py-3.5 text-slate-500">6 個月</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">不限時間</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">完整健康趨勢圖與 PDF 匯出</td><td class="text-center px-4 py-3.5 text-slate-300">—</td><td class="text-center px-4 py-3.5">✓</td></tr>
            <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">醫療與照護</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">就診紀錄與血檢數值</td><td class="text-center px-4 py-3.5">✓</td><td class="text-center px-4 py-3.5">✓</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">掃描血檢報告</td><td class="text-center px-4 py-3.5 text-slate-500">2 次/月</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">不限次數</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">照片上傳</td><td class="text-center px-4 py-3.5 text-slate-500">每筆 1 張／共 50 張</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">每筆 5 張／不限總數</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">重複提醒、藥品管理、健康指數與風險提醒</td><td class="text-center px-4 py-3.5 text-slate-300">—</td><td class="text-center px-4 py-3.5">✓</td></tr>
            <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">用品與花費</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">物品倉庫、記帳與醫療基金</td><td class="text-center px-4 py-3.5">✓</td><td class="text-center px-4 py-3.5">✓</td></tr>
            <tr class="bg-orange-50/40"><td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="3">AI 功能</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">AI 日常健康摘要</td><td class="text-center px-4 py-3.5 text-slate-300">—</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">10 次/月</td></tr>
            <tr><td class="px-6 py-3.5 text-slate-700">AI 看診報告摘要</td><td class="text-center px-4 py-3.5 text-slate-300">—</td><td class="text-center px-4 py-3.5 text-brand-orange font-semibold">10 次/月</td></tr>
          </tbody></table>
        </div>
      </div>
    </PricingContent>
  </div></div>
  <Footer />
</BaseLayout>

<script>
  function setPeriod(period) {
    document.querySelectorAll('[data-monthly-price]').forEach((el) => { el.textContent = period === 'monthly' ? el.dataset.monthlyPrice : el.dataset.annualPrice; });
    document.querySelectorAll('[data-plan-subtitle]').forEach((el) => { el.textContent = period === 'monthly' ? el.dataset.monthlySubtitle : el.dataset.annualSubtitle; });
    const btnMonthly = document.getElementById('btn-monthly'); const btnAnnual = document.getElementById('btn-annual');
    if (!btnMonthly || !btnAnnual) return;
    btnMonthly.className = `px-5 py-2 rounded-xl text-sm font-semibold transition ${period === 'monthly' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500'}`;
    btnAnnual.className = `px-5 py-2 rounded-xl text-sm font-semibold transition ${period === 'annual' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500'}`;
  }
  window.setPeriod = setPeriod;
</script>
