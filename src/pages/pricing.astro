---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PricingContent from '../components/pages/PricingContent.astro';
import { getEntry } from 'astro:content';

const p = await getEntry('pricing', 'zh-tw/page');
const {
  seoTitle, seoDescription,
  pageTitle, pageSubtitle, trialBadge,
  periodMonthly, periodAnnual, periodAnnualSave,
  plans, notes,
  ctaTitle, ctaSubtitle, ctaButton,
} = p.data;
const { data: { ctaUrl } } = await getEntry('global', 'settings');
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <Nav />

  <div class="pt-28 pb-20 px-6">
    <div class="max-w-5xl mx-auto">

      <PricingContent
        pageTitle={pageTitle}
        pageSubtitle={pageSubtitle}
        trialBadge={trialBadge}
        periodMonthly={periodMonthly}
        periodAnnual={periodAnnual}
        periodAnnualSave={periodAnnualSave}
        plans={plans}
        notes={notes}
        ctaTitle={ctaTitle}
        ctaSubtitle={ctaSubtitle}
        ctaButton={ctaButton}
        ctaUrl={ctaUrl}
        perMonthLabel="/月"
      >
        <!-- 功能比較表 -->
        <div class="mb-16">
          <h2 class="text-2xl font-bold text-slate-900 text-center mb-8">完整功能比較</h2>
          <div class="overflow-x-auto rounded-3xl border border-slate-100 shadow-sm">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-slate-50 border-b border-slate-100">
                  <th class="text-left px-6 py-4 font-semibold text-slate-500 w-1/2">功能</th>
                  <th class="text-center px-4 py-4 font-semibold text-slate-600">Free</th>
                  <th class="text-center px-4 py-4 font-semibold text-blue-600">Pro</th>
                  <th class="text-center px-4 py-4 font-semibold text-amber-600">Premium</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50">
                <tr class="bg-orange-50/40">
                  <td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="4">基本限制</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">貓咪數量</td>
                  <td class="text-center px-4 py-3.5 text-slate-600">2 隻</td>
                  <td class="text-center px-4 py-3.5 text-blue-600 font-semibold">5 隻</td>
                  <td class="text-center px-4 py-3.5 text-amber-600 font-semibold">無限</td>
                </tr>
                <tr class="bg-orange-50/40">
                  <td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="4">每日記錄</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">飲食 / 飲水 / 排泄 / 體重</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="bg-orange-50/40">
                  <td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="4">健康圖表</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">體重趨勢圖</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">飲食 / 飲水圖表</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">圖表顯示範圍</td>
                  <td class="text-center px-4 py-3.5 text-slate-500">6 個月</td>
                  <td class="text-center px-4 py-3.5 text-slate-600">1 年</td>
                  <td class="text-center px-4 py-3.5 text-amber-600 font-semibold">無限</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">排泄趨勢圖</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">血檢趨勢圖</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">匯出紀錄（PDF）</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="bg-orange-50/40">
                  <td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="4">就診紀錄</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">就診紀錄（純文字）</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">血檢數值紀錄</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">掃描血檢報告</td>
                  <td class="text-center px-4 py-3.5 text-slate-500">2 次/月</td>
                  <td class="text-center px-4 py-3.5 text-slate-600">10 次/月</td>
                  <td class="text-center px-4 py-3.5 text-amber-600 font-semibold">不限</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">就診照片上傳</td>
                  <td class="text-center px-4 py-3.5 text-slate-500">每筆 1 張</td>
                  <td class="text-center px-4 py-3.5 text-slate-600">每筆 5 張</td>
                  <td class="text-center px-4 py-3.5 text-slate-600">每筆 5 張</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">照片總上限</td>
                  <td class="text-center px-4 py-3.5 text-slate-500">50 張</td>
                  <td class="text-center px-4 py-3.5 text-blue-600 font-semibold">無限</td>
                  <td class="text-center px-4 py-3.5 text-amber-600 font-semibold">無限</td>
                </tr>
                <tr class="bg-orange-50/40">
                  <td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="4">提醒通知</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">單次提醒（疫苗/回診）</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">重複提醒</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">藥品管理</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="bg-orange-50/40">
                  <td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="4">貓咪記帳簿</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">記帳 + 月花費總覽</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">醫療基金餘額追蹤</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">完整花費分類 + 圓餅圖</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="bg-orange-50/40">
                  <td class="px-6 py-3 font-bold text-slate-700 text-xs uppercase tracking-wide" colspan="4">AI 功能</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">AI 日常健康摘要</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5 text-slate-600">5 次/月</td>
                  <td class="text-center px-4 py-3.5 text-amber-600 font-semibold">10 次/月</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">AI 醫療摘要（看診報告）</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5 text-amber-600 font-semibold">10 次/月</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">健康指數評估</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                  <td class="px-6 py-3.5 text-slate-700">健康風險預警</td>
                  <td class="text-center px-4 py-3.5 text-slate-300">—</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                  <td class="text-center px-4 py-3.5">✓</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </PricingContent>

    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  function setPeriod(period: 'monthly' | 'annual') {
    document.querySelectorAll<HTMLElement>('[data-monthly-price]').forEach((el) => {
      el.textContent = period === 'monthly'
        ? el.dataset.monthlyPrice!
        : el.dataset.annualPrice!;
    });

    document.querySelectorAll<HTMLElement>('[data-plan-subtitle]').forEach((el) => {
      el.textContent = period === 'monthly'
        ? el.dataset.monthlySubtitle!
        : el.dataset.annualSubtitle!;
    });

    document.querySelectorAll<HTMLElement>('[data-plan-annual-note]').forEach((el) => {
      el.textContent = '';
    });

    const btnMonthly = document.getElementById('btn-monthly')!;
    const btnAnnual  = document.getElementById('btn-annual')!;
    if (period === 'monthly') {
      btnMonthly.className = 'px-5 py-2 rounded-xl text-sm font-semibold transition bg-white text-slate-900 shadow-sm';
      btnAnnual.className  = 'px-5 py-2 rounded-xl text-sm font-semibold transition text-slate-500';
    } else {
      btnAnnual.className  = 'px-5 py-2 rounded-xl text-sm font-semibold transition bg-white text-slate-900 shadow-sm';
      btnMonthly.className = 'px-5 py-2 rounded-xl text-sm font-semibold transition text-slate-500';
    }
  }

  (window as any).setPeriod = setPeriod;
</script>
