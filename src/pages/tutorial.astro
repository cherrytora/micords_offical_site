---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TutorialContent from '../components/pages/TutorialContent.astro';
import { getEntry } from 'astro:content';

const tutorial = await getEntry('tutorial', 'zh-tw/page');
const { pageTitle, pageSubtitle, sections, ctaTitle, ctaSubtitle, ctaButton, seoTitle, seoDescription } = tutorial.data;
const { data: { ctaUrl } } = await getEntry('global', 'settings');
---

<BaseLayout title={seoTitle ?? pageTitle} description={seoDescription}>
  <Nav />
  <TutorialContent
    pageTitle={pageTitle}
    pageSubtitle={pageSubtitle}
    sections={sections}
    ctaTitle={ctaTitle}
    ctaSubtitle={ctaSubtitle}
    ctaButton={ctaButton}
    ctaUrl={ctaUrl}
    navLabel="教學章節"
  />
  <Footer />
</BaseLayout>
