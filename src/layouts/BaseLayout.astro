---
import '../styles/global.css';
import type { Locale } from '../i18n/index';
import { htmlLang, ogLocale } from '../i18n/index';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
}

const {
  title,
  description = 'Micords 是專為貓咪設計的健康紀錄 APP，記錄飲食、體重、血檢與用藥，自動生成趨勢圖表，看診時一鍵出示完整病歷。免費使用。',
  keywords = '貓咪APP,貓咪健康紀錄,寵物APP,貓咪體重記錄,貓咪血檢,貓咪用藥紀錄,寵物健康管理,毛孩日常,毛孩日記,毛孩健康管理,毛孩健康紀錄,貓貓健康管理,寵物記帳,貓咪花費紀錄,貓咪醫療費用,毛孩消費管理,寵物用品管理,貓咪用品清單,貓糧管理,Micords',
} = Astro.props;

const locale = (Astro.currentLocale ?? 'zh-tw') as Locale;
const lang = htmlLang[locale] ?? 'zh-TW';
const ogLoc = ogLocale[locale] ?? 'zh_TW';

const siteUrl = 'https://cherrytora.github.io/micords_offical_site';
const currentUrl = `${siteUrl}${Astro.url.pathname}`;
const ogImage = `${siteUrl}/Micords.png`;

// hreflang alternate URLs for SEO
const pagePathRaw = Astro.url.pathname.replace(/^\/micords_offical_site/, '') || '/';
const hreflangs = [
  { hreflang: 'zh-TW', href: `${siteUrl}${pagePathRaw}` },
  { hreflang: 'en',    href: `${siteUrl}/en${pagePathRaw === '/' ? '' : pagePathRaw}` },
  { hreflang: 'ja',    href: `${siteUrl}/ja${pagePathRaw === '/' ? '' : pagePathRaw}` },
  { hreflang: 'x-default', href: `${siteUrl}${pagePathRaw}` },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="icon" type="image/png" href={`${siteUrl}/Micords-icon.png`} />
    <link rel="apple-touch-icon" href={`${siteUrl}/Micords-icon.png`} />

    <!-- hreflang for i18n SEO -->
    {hreflangs.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:locale" content={ogLoc} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <link rel="canonical" href={currentUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "SoftwareApplication",
          "name": "Micords 貓咪健康紀錄簿",
          "alternateName": "Micords（貓咪 + Records）",
          "description": description,
          "url": "https://micords.web.app/",
          "applicationCategory": "HealthApplication",
          "operatingSystem": "Web, Android, iOS",
          "inLanguage": lang,
          "image": ogImage,
          "featureList": "飲食紀錄, 體重追蹤, 血檢管理, 用藥紀錄, 趨勢圖表, 病歷匯出",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "TWD"
          },
          "author": {
            "@type": "Organization",
            "@id": `${siteUrl}/#organization`
          }
        },
        {
          "@type": "WebSite",
          "name": "Micords",
          "url": siteUrl,
          "inLanguage": lang,
          "publisher": {
            "@type": "Organization",
            "@id": `${siteUrl}/#organization`
          }
        },
        {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          "name": "RiLa Tech",
          "url": siteUrl
        }
      ]
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
